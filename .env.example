# ==========================================
# OpenFamily - Variables de Configuración
# ==========================================

# Puerto de escucha del servidor
PORT=3000

# Zona horaria (ej. Europe/Madrid, America/Mexico_City, America/Bogota)
TZ=Europe/Madrid

# Ubicación para el Widget de Clima (Open-Meteo 7 días)
CITY_NAME=Madrid
LATITUDE=40.4168
LONGITUDE=-3.7038

# Seguridad y Acceso
PARENT_PIN=1234
ADMIN_PASSWORD=TuContraseñaAdminSegura123.
AUTH_SECRET=GeneraUnaClaveSecretaMuyLargaYUnica2026!
KIOSK_TOKEN=clave_de_acceso_directo_kiosk_pantalla

# Integración de Agenda Externa opcional (feed iCal de ayuntamiento o comunidad)
ICAL_URL=
